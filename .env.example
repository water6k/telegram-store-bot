# --- Telegram ---
BOT_TOKEN=123456789:AA...your_token_from_BotFather
BOT_USERNAME=your_bot_username

# --- Supabase (Project Settings -> Data API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# --- Admin(s): your Telegram user ID (comma separated). Get it from @userinfobot ---
ADMIN_TELEGRAM_ID=123456789

# --- Deployment ---
VERCEL_URL=https://your-app.vercel.app

# --- Cron (must match Vercel CRON_SECRET so only Vercel can call /api/cron) ---
CRON_SECRET=some_long_random_string
